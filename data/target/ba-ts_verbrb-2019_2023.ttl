@prefix cube: <https://cube.link/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix enerprop: <https://berlin.github.io/lod-energyconsumption/properties/> .
@prefix enerstat: <https://berlin.github.io/lod-energyconsumption/statistics/> .
@prefix enervoc: <https://berlin.github.io/lod-energyconsumption/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

enerstat:cube a cube:Cube ;
    cube:observationSet enerstat:os_2019-co2,
        enerstat:os_2019-heating,
        enerstat:os_2019-power,
        enerstat:os_2020-co2,
        enerstat:os_2020-heating,
        enerstat:os_2020-power,
        enerstat:os_2021-co2,
        enerstat:os_2021-heating,
        enerstat:os_2021-power,
        enerstat:os_2022-co2,
        enerstat:os_2022-heating,
        enerstat:os_2022-power,
        enerstat:os_2023-co2,
        enerstat:os_2023-heating,
        enerstat:os_2023-power ;
    schema:description """Data Cube mit statistischen Daten zum Energieverbrauch
                                                  öffentlicher Liegenschaften im Berliner Bezirk
                                                  Tempelhof-Schöneberg."""@de,
        """Data cube containing statistical
                                                  data about energy consumption in Berlin's
                                                  district of Tempelhof-Schöneberg."""@en ;
    schema:name "Energieverbrauch Tempelhof-Schöneberg"@de,
        "Energy consumption Tempelhof-Schöneberg"@en .

